# Example .env file for Word Feedback Feature

# Google Sheets Configuration
# Get your spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SHEETS_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789

# Google Sheets Service Account Credentials
# Copy the ENTIRE contents of your service account JSON file and paste it as a single line
# Important: Use single quotes around the JSON, keep double quotes inside
GOOGLE_SHEETS_CREDENTIALS='{"type":"service_account","project_id":"taboo-feedback","private_key_id":"abc123def456","private_key":"-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n","client_email":"taboo-feedback@your-project.iam.gserviceaccount.com","client_id":"123456789","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/taboo-feedback%40your-project.iam.gserviceaccount.com"}'

# Note: This is an example. Replace with your actual credentials.
# NEVER commit this file to version control!
# Add .env to your .gitignore file

# ---------------------------------------------------------------------------
# Frontend (frontend/.env.local or your Vercel/Netlify dashboard)
# See SERVERLESS.md
# ---------------------------------------------------------------------------
# p2p (default) = serverless, the room creator's device hosts the game
# server        = classic Socket.IO backend at NEXT_PUBLIC_SERVER_URL (rollback switch)
# NEXT_PUBLIC_GAME_MODE=server
# NEXT_PUBLIC_SERVER_URL=https://your-backend.onrender.com
# NEXT_PUBLIC_PEER_OPTIONS={"config":{"iceServers":[{"urls":"stun:stun.l.google.com:19302"}]}}
# NEXT_PUBLIC_FEEDBACK_URL=https://script.google.com/macros/s/XXXX/exec

# Branding / legal (website keeps "Taboo" unless overridden; store builds use "Inferno Words")
# NEXT_PUBLIC_APP_NAME=Taboo
# NEXT_PUBLIC_PUBLISHER_NAME=Ishpreet
# NEXT_PUBLIC_SUPPORT_EMAIL=you@yourdomain.com
# NEXT_PUBLIC_WEB_URL=https://taboo-inferno.vercel.app

# Monetization (native apps only; see MOBILE.md). Unset = Google TEST ads, store disabled.
# NEXT_PUBLIC_RC_ANDROID_KEY=goog_xxx
# NEXT_PUBLIC_RC_IOS_KEY=appl_xxx
# NEXT_PUBLIC_ADMOB_ANDROID_BANNER=ca-app-pub-xxx/yyy
# NEXT_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=ca-app-pub-xxx/yyy
# NEXT_PUBLIC_ADMOB_IOS_BANNER=ca-app-pub-xxx/yyy
# NEXT_PUBLIC_ADMOB_IOS_INTERSTITIAL=ca-app-pub-xxx/yyy
# NEXT_PUBLIC_LOCK_PREMIUM_ON_WEB=true
